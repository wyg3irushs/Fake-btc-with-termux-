//@version=5
indicator("Institutional Liquidity Premium v2", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────
// ██  INPUTS
// ─────────────────────────────────────────────

// — Signal Engine
swingLen       = input.int(5,     "Swing Lookback",              minval=2,  maxval=50,  group="⚙️ Signal Engine")
atrLen         = input.int(14,    "ATR Length (volatility)",     minval=5,  maxval=50,  group="⚙️ Signal Engine")
atrMult        = input.float(1.5, "ATR Multiplier for SL",      minval=0.5,maxval=5.0, step=0.1, group="⚙️ Signal Engine")
riskReward1    = input.float(1.0, "TP1 Risk:Reward",            minval=0.5,maxval=10,  step=0.5, group="⚙️ Signal Engine")
riskReward2    = input.float(1.5, "TP2 Risk:Reward",            minval=0.5,maxval=10,  step=0.5, group="⚙️ Signal Engine")
riskReward3    = input.float(2.0, "TP3 Risk:Reward",            minval=0.5,maxval=10,  step=0.5, group="⚙️ Signal Engine")
riskReward4    = input.float(3.0, "TP4 Risk:Reward",            minval=0.5,maxval=10,  step=0.5, group="⚙️ Signal Engine")
riskReward5    = input.float(4.0, "TP5 Risk:Reward",            minval=0.5,maxval=10,  step=0.5, group="⚙️ Signal Engine")

// — Confluence Filters
useEMA         = input.bool(true, "Use EMA Trend Filter",       group="🔍 Confluence")
emaLen         = input.int(50,    "EMA Length",                  minval=10, maxval=200, group="🔍 Confluence")
useRSI         = input.bool(true, "Use RSI Filter",             group="🔍 Confluence")
rsiLen         = input.int(14,    "RSI Length",                  minval=5,  maxval=50,  group="🔍 Confluence")
rsiOB          = input.int(70,    "RSI Overbought",             minval=60, maxval=90,  group="🔍 Confluence")
rsiOS          = input.int(30,    "RSI Oversold",               minval=10, maxval=40,  group="🔍 Confluence")
useVol         = input.bool(true, "Use Volume Spike Filter",    group="🔍 Confluence")
volMult        = input.float(1.5, "Volume Spike Multiplier",    minval=1.0,maxval=5.0, step=0.1, group="🔍 Confluence")

// — Visual Design
buyColor       = input.color(#00E676, "Buy Setup Color",        group="🎨 Design")
sellColor      = input.color(#FF1744, "Sell Setup Color",        group="🎨 Design")
slColor        = input.color(#FF5252, "Stop Loss Color",         group="🎨 Design")
tpColor        = input.color(#69F0AE, "Take Profit Color",       group="🎨 Design")
entryColor     = input.color(#FFFFFF, "Entry Line Color",         group="🎨 Design")
checkColor     = input.color(#00E676, "TP Hit Checkmark Color",  group="🎨 Design")
textCol        = input.color(#FFFFFF, "Text Color",              group="🎨 Design")
maxSetups      = input.int(5,     "Max Active Setups on Chart",  minval=1,  maxval=20,  group="🎨 Design")

// — Premium / Discount (subtle background)
showPD         = input.bool(true, "Show Premium/Discount Background", group="🏦 Institutional Zones")
pdLookback     = input.int(50,    "Range Lookback",              minval=10, maxval=200, group="🏦 Institutional Zones")

// ─────────────────────────────────────────────
// ██  CORE CALCULATIONS
// ─────────────────────────────────────────────

atr    = ta.atr(atrLen)
ema    = ta.ema(close, emaLen)
rsi    = ta.rsi(close, rsiLen)
avgVol = ta.sma(volume, 20)

// Swing detection
swingHigh = ta.pivothigh(high, swingLen, swingLen)
swingLow  = ta.pivotlow(low,  swingLen, swingLen)

var float lastSH = na
var float lastSL = na
var int   trend  = 0

if not na(swingHigh)
    lastSH := swingHigh
if not na(swingLow)
    lastSL := swingLow

// Structure breaks
bosUp   = not na(lastSH) and ta.crossover(close, lastSH)
bosDown = not na(lastSL) and ta.crossunder(close, lastSL)

if bosUp
    trend := 1
if bosDown
    trend := -1

// Confluence filters
emaUpOK   = not useEMA or close > ema
emaDownOK = not useEMA or close < ema
rsiUpOK   = not useRSI or rsi < rsiOB
rsiDownOK = not useRSI or rsi > rsiOS
volOK     = not useVol  or volume > avgVol * volMult

// Fair Value Gap detection (clean — used as entry trigger)
bullFVG = low > high[2] and close[1] > open[1]
bearFVG = high < low[2] and close[1] < open[1]

// ─────────────────────────────────────────────
// ██  SIGNAL GENERATION
// ─────────────────────────────────────────────

// BUY: bullish BOS + bullish FVG within 3 bars + confluence
buySignal  = bosUp   and emaUpOK   and rsiUpOK   and volOK
// SELL: bearish BOS + bearish FVG within 3 bars + confluence
sellSignal = bosDown and emaDownOK and rsiDownOK and volOK

// Cooldown to avoid signal spam
var int lastSignalBar = 0
cooldown = bar_index - lastSignalBar > swingLen * 2

buyTrigger  = buySignal  and cooldown
sellTrigger = sellSignal and cooldown

if buyTrigger or sellTrigger
    lastSignalBar := bar_index

// ─────────────────────────────────────────────
// ██  USER-DEFINED TYPE: Trade Setup
// ─────────────────────────────────────────────

type TradeSetup
    int    barIdx
    int    dir          // 1 = buy, -1 = sell
    float  entry
    float  sl
    float  tp1
    float  tp2
    float  tp3
    float  tp4
    float  tp5
    bool   tp1Hit
    bool   tp2Hit
    bool   tp3Hit
    bool   tp4Hit
    bool   tp5Hit
    bool   slHit
    bool   closed
    // Drawing references
    box    setupBox
    line   entryLine
    line   slLine
    line   tp1Line
    line   tp2Line
    line   tp3Line
    line   tp4Line
    line   tp5Line
    label  entryLabel
    label  slLabel
    label  tp1Label
    label  tp2Label
    label  tp3Label
    label  tp4Label
    label  tp5Label
    label  signalLabel
    label  resultLabel

// ─────────────────────────────────────────────
// ██  SETUP MANAGEMENT
// ─────────────────────────────────────────────

var array<TradeSetup> setups = array.new<TradeSetup>()

// Create a new trade setup
createSetup(int dir) =>
    entryPrice = close
    slDist     = atr * atrMult
    slPrice    = dir == 1 ? entryPrice - slDist : entryPrice + slDist
    risk       = math.abs(entryPrice - slPrice)

    tp1Price = dir == 1 ? entryPrice + risk * riskReward1 : entryPrice - risk * riskReward1
    tp2Price = dir == 1 ? entryPrice + risk * riskReward2 : entryPrice - risk * riskReward2
    tp3Price = dir == 1 ? entryPrice + risk * riskReward3 : entryPrice - risk * riskReward3
    tp4Price = dir == 1 ? entryPrice + risk * riskReward4 : entryPrice - risk * riskReward4
    tp5Price = dir == 1 ? entryPrice + risk * riskReward5 : entryPrice - risk * riskReward5

    rightEdge = bar_index + 30
    mainColor = dir == 1 ? buyColor : sellColor

    // Setup zone box (entry to TP1)
    boxTop    = dir == 1 ? tp1Price   : entryPrice
    boxBot    = dir == 1 ? entryPrice : tp1Price
    sBox = box.new(bar_index, boxTop, rightEdge, boxBot, border_color=mainColor, bgcolor=color.new(mainColor, 88), border_width=1)

    // Entry line
    eLine = line.new(bar_index, entryPrice, rightEdge, entryPrice, color=entryColor, style=line.style_solid, width=2)

    // SL line
    sLine = line.new(bar_index, slPrice, rightEdge, slPrice, color=slColor, style=line.style_dashed, width=2)

    // TP lines
    t1Line = line.new(bar_index, tp1Price, rightEdge, tp1Price, color=tpColor, style=line.style_dotted, width=1)
    t2Line = line.new(bar_index, tp2Price, rightEdge, tp2Price, color=tpColor, style=line.style_dotted, width=1)
    t3Line = line.new(bar_index, tp3Price, rightEdge, tp3Price, color=tpColor, style=line.style_dotted, width=1)
    t4Line = line.new(bar_index, tp4Price, rightEdge, tp4Price, color=tpColor, style=line.style_dotted, width=1)
    t5Line = line.new(bar_index, tp5Price, rightEdge, tp5Price, color=tpColor, style=line.style_dotted, width=1)

    // Signal label (BUY / SELL)
    sigStyle = dir == 1 ? label.style_label_up : label.style_label_down
    sigY     = dir == 1 ? low - atr * 0.5 : high + atr * 0.5
    sigText  = dir == 1 ? "🟢 BUY" : "🔴 SELL"
    sigLbl   = label.new(bar_index, sigY, sigText, style=sigStyle, color=mainColor, textcolor=textCol, size=size.large)

    // Entry price label
    entLbl = label.new(rightEdge, entryPrice, "▸ ENTRY  " + str.tostring(entryPrice, format.mintick), style=label.style_label_left, color=color.new(mainColor, 30), textcolor=textCol, size=size.small)

    // SL label
    slLbl = label.new(rightEdge, slPrice, "✖ SL  " + str.tostring(slPrice, format.mintick), style=label.style_label_left, color=color.new(slColor, 30), textcolor=textCol, size=size.small)

    // TP labels
    t1Lbl = label.new(rightEdge, tp1Price, "◻ TP1  " + str.tostring(tp1Price, format.mintick), style=label.style_label_left, color=color.new(tpColor, 50), textcolor=textCol, size=size.tiny)
    t2Lbl = label.new(rightEdge, tp2Price, "◻ TP2  " + str.tostring(tp2Price, format.mintick), style=label.style_label_left, color=color.new(tpColor, 50), textcolor=textCol, size=size.tiny)
    t3Lbl = label.new(rightEdge, tp3Price, "◻ TP3  " + str.tostring(tp3Price, format.mintick), style=label.style_label_left, color=color.new(tpColor, 50), textcolor=textCol, size=size.tiny)
    t4Lbl = label.new(rightEdge, tp4Price, "◻ TP4  " + str.tostring(tp4Price, format.mintick), style=label.style_label_left, color=color.new(tpColor, 50), textcolor=textCol, size=size.tiny)
    t5Lbl = label.new(rightEdge, tp5Price, "◻ TP5  " + str.tostring(tp5Price, format.mintick), style=label.style_label_left, color=color.new(tpColor, 50), textcolor=textCol, size=size.tiny)

    setup = TradeSetup.new(
     barIdx      = bar_index,
     dir         = dir,
     entry       = entryPrice,
     sl          = slPrice,
     tp1         = tp1Price,
     tp2         = tp2Price,
     tp3         = tp3Price,
     tp4         = tp4Price,
     tp5         = tp5Price,
     tp1Hit      = false,
     tp2Hit      = false,
     tp3Hit      = false,
     tp4Hit      = false,
     tp5Hit      = false,
     slHit       = false,
     closed      = false,
     setupBox    = sBox,
     entryLine   = eLine,
     slLine      = sLine,
     tp1Line     = t1Line,
     tp2Line     = t2Line,
     tp3Line     = t3Line,
     tp4Line     = t4Line,
     tp5Line     = t5Line,
     entryLabel  = entLbl,
     slLabel     = slLbl,
     tp1Label    = t1Lbl,
     tp2Label    = t2Lbl,
     tp3Label    = t3Lbl,
     tp4Label    = t4Lbl,
     tp5Label    = t5Lbl,
     signalLabel = sigLbl,
     resultLabel = label(na))

    setup

// Delete all drawings for a setup
deleteSetup(TradeSetup s) =>
    box.delete(s.setupBox)
    line.delete(s.entryLine)
    line.delete(s.slLine)
    line.delete(s.tp1Line)
    line.delete(s.tp2Line)
    line.delete(s.tp3Line)
    line.delete(s.tp4Line)
    line.delete(s.tp5Line)
    label.delete(s.entryLabel)
    label.delete(s.slLabel)
    label.delete(s.tp1Label)
    label.delete(s.tp2Label)
    label.delete(s.tp3Label)
    label.delete(s.tp4Label)
    label.delete(s.tp5Label)
    label.delete(s.signalLabel)
    label.delete(s.resultLabel)

// ─────────────────────────────────────────────
// ██  CREATE NEW SETUPS
// ─────────────────────────────────────────────

if buyTrigger
    newSetup = createSetup(1)
    array.push(setups, newSetup)

if sellTrigger
    newSetup = createSetup(-1)
    array.push(setups, newSetup)

// ─────────────────────────────────────────────
// ██  UPDATE ACTIVE SETUPS (TP hits, SL hits)
// ─────────────────────────────────────────────

if array.size(setups) > 0
    for i = array.size(setups) - 1 to 0
        s = array.get(setups, i)
        if s.closed
            continue

        rightEdge = bar_index + 5

        // Extend lines to current bar
        box.set_right(s.setupBox, rightEdge)
        line.set_x2(s.entryLine, rightEdge)
        line.set_x2(s.slLine, rightEdge)
        line.set_x2(s.tp1Line, rightEdge)
        line.set_x2(s.tp2Line, rightEdge)
        line.set_x2(s.tp3Line, rightEdge)
        line.set_x2(s.tp4Line, rightEdge)
        line.set_x2(s.tp5Line, rightEdge)

        // Move labels to right edge
        label.set_x(s.entryLabel, rightEdge)
        label.set_x(s.slLabel, rightEdge)
        label.set_x(s.tp1Label, rightEdge)
        label.set_x(s.tp2Label, rightEdge)
        label.set_x(s.tp3Label, rightEdge)
        label.set_x(s.tp4Label, rightEdge)
        label.set_x(s.tp5Label, rightEdge)

        isBuy = s.dir == 1

        // Check TP hits and update labels with checkmark ✅
        if not s.tp1Hit and ((isBuy and high >= s.tp1) or (not isBuy and low <= s.tp1))
            s.tp1Hit := true
            label.set_text(s.tp1Label, "✅ TP1  " + str.tostring(s.tp1, format.mintick))
            label.set_color(s.tp1Label, color.new(checkColor, 20))

        if not s.tp2Hit and ((isBuy and high >= s.tp2) or (not isBuy and low <= s.tp2))
            s.tp2Hit := true
            label.set_text(s.tp2Label, "✅ TP2  " + str.tostring(s.tp2, format.mintick))
            label.set_color(s.tp2Label, color.new(checkColor, 20))

        if not s.tp3Hit and ((isBuy and high >= s.tp3) or (not isBuy and low <= s.tp3))
            s.tp3Hit := true
            label.set_text(s.tp3Label, "✅ TP3  " + str.tostring(s.tp3, format.mintick))
            label.set_color(s.tp3Label, color.new(checkColor, 20))

        if not s.tp4Hit and ((isBuy and high >= s.tp4) or (not isBuy and low <= s.tp4))
            s.tp4Hit := true
            label.set_text(s.tp4Label, "✅ TP4  " + str.tostring(s.tp4, format.mintick))
            label.set_color(s.tp4Label, color.new(checkColor, 20))

        if not s.tp5Hit and ((isBuy and high >= s.tp5) or (not isBuy and low <= s.tp5))
            s.tp5Hit := true
            label.set_text(s.tp5Label, "✅ TP5  " + str.tostring(s.tp5, format.mintick))
            label.set_color(s.tp5Label, color.new(checkColor, 20))
            // All TPs hit — mark trade as complete
            s.closed := true
            box.set_border_color(s.setupBox, checkColor)
            box.set_bgcolor(s.setupBox, color.new(checkColor, 90))
            s.resultLabel := label.new(bar_index, isBuy ? high + atr * 0.3 : low - atr * 0.3, "🏆 FULL TP", style=isBuy ? label.style_label_down : label.style_label_up, color=checkColor, textcolor=color.black, size=size.normal)

        // Check SL hit
        if not s.slHit and ((isBuy and low <= s.sl) or (not isBuy and high >= s.sl))
            s.slHit  := true
            s.closed := true
            label.set_text(s.slLabel, "❌ SL HIT  " + str.tostring(s.sl, format.mintick))
            label.set_color(s.slLabel, color.new(slColor, 10))
            box.set_border_color(s.setupBox, slColor)
            box.set_bgcolor(s.setupBox, color.new(slColor, 92))
            line.set_color(s.entryLine, color.new(entryColor, 70))
            s.resultLabel := label.new(bar_index, isBuy ? low - atr * 0.3 : high + atr * 0.3, "❌ STOPPED", style=isBuy ? label.style_label_up : label.style_label_down, color=slColor, textcolor=textCol, size=size.normal)

        // Close trade after too many bars (expire stale setups)
        if bar_index - s.barIdx > 200 and not s.closed
            s.closed := true

        array.set(setups, i, s)

// Limit total setups on chart
while array.size(setups) > maxSetups
    oldest = array.shift(setups)
    deleteSetup(oldest)

// ─────────────────────────────────────────────
// ██  PREMIUM / DISCOUNT SUBTLE BACKGROUND
// ─────────────────────────────────────────────

if showPD
    rangeH   = ta.highest(high, pdLookback)
    rangeL   = ta.lowest(low,   pdLookback)
    rangeMid = (rangeH + rangeL) / 2.0

    inPrem = close > rangeMid + (rangeH - rangeL) * 0.25
    inDisc = close < rangeMid - (rangeH - rangeL) * 0.25

    bgcolor(inPrem ? color.new(sellColor, 95) : na, title="Premium BG")
    bgcolor(inDisc ? color.new(buyColor,  95) : na, title="Discount BG")

// ─────────────────────────────────────────────
// ██  EMA TREND LINE (subtle)
// ─────────────────────────────────────────────

plot(useEMA ? ema : na, "EMA", color=color.new(color.gray, 60), linewidth=1)

// ─────────────────────────────────────────────
// ██  INFO DASHBOARD
// ─────────────────────────────────────────────

var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(#1a1a2e, 10), border_width=1, border_color=color.new(color.gray, 70), frame_width=1, frame_color=color.new(color.gray, 60))

if barstate.islast
    trendTxt = trend == 1 ? "BULLISH ▲" : trend == -1 ? "BEARISH ▼" : "NEUTRAL"
    trendCol = trend == 1 ? buyColor : trend == -1 ? sellColor : color.gray

    rangeH   = ta.highest(high, pdLookback)
    rangeL   = ta.lowest(low,   pdLookback)
    rangeMid = (rangeH + rangeL) / 2.0
    zoneTxt  = close > rangeMid + (rangeH - rangeL) * 0.25 ? "PREMIUM ⚠️" : close < rangeMid - (rangeH - rangeL) * 0.25 ? "DISCOUNT 💰" : "EQUILIBRIUM"
    zoneCol  = close > rangeMid + (rangeH - rangeL) * 0.25 ? sellColor : close < rangeMid - (rangeH - rangeL) * 0.25 ? buyColor : color.gray

    activeCount = 0
    if array.size(setups) > 0
        for i = 0 to array.size(setups) - 1
            if not array.get(setups, i).closed
                activeCount += 1

    table.cell(dash, 0, 0, "TREND",          text_color=color.gray,  text_size=size.tiny, text_halign=text.align_right)
    table.cell(dash, 1, 0, trendTxt,          text_color=trendCol,    text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 0, 1, "ZONE",            text_color=color.gray,  text_size=size.tiny, text_halign=text.align_right)
    table.cell(dash, 1, 1, zoneTxt,           text_color=zoneCol,     text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 0, 2, "RSI",             text_color=color.gray,  text_size=size.tiny, text_halign=text.align_right)
    table.cell(dash, 1, 2, str.tostring(rsi, "#.0"), text_color=rsi > rsiOB ? sellColor : rsi < rsiOS ? buyColor : color.silver, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 0, 3, "ACTIVE",          text_color=color.gray,  text_size=size.tiny, text_halign=text.align_right)
    table.cell(dash, 1, 3, str.tostring(activeCount) + " setups", text_color=color.silver, text_size=size.small, text_halign=text.align_left)

// ─────────────────────────────────────────────
// ██  ALERTS
// ─────────────────────────────────────────────

alertcondition(buyTrigger,  title="BUY Signal",  message="🟢 BUY Signal — Institutional Liquidity Premium")
alertcondition(sellTrigger, title="SELL Signal",  message="🔴 SELL Signal — Institutional Liquidity Premium")
