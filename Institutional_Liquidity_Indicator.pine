// https://mozilla.org/MPL/2.0/
// © wyg3irushs — Institutional Liquidity Premium Indicator v3 (Scalping Edition)

//@version=5
indicator("Institutional Liquidity Premium v3", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────
// ██  INPUTS
// ─────────────────────────────────────────────────────

// Scalping Mode
i_scalpMode   = input.bool(false, "Scalping Mode (auto-optimize)",  group="Scalping Mode")

// Signal Engine
i_swingLen    = input.int(5,     "Swing Lookback",          minval=1,   maxval=50,  group="Signal Engine")
i_atrLen      = input.int(14,    "ATR Length",              minval=3,   maxval=50,  group="Signal Engine")
i_atrMult     = input.float(1.5, "ATR Multiplier (SL)",    minval=0.3, maxval=5.0, step=0.1, group="Signal Engine")
i_cooldown    = input.int(10,    "Cooldown (bars)",         minval=0,   maxval=50,  group="Signal Engine")
i_minAtrPct   = input.float(0.0, "Min ATR % (filter flat)", minval=0.0, maxval=2.0, step=0.1, group="Signal Engine")

// TP Levels
i_useTP0      = input.bool(false, "Enable TP0 (ultra-fast)", group="TP Levels")
i_rr0         = input.float(0.4, "TP0 Risk:Reward",        minval=0.1, maxval=2.0, step=0.1, group="TP Levels")
i_rr1         = input.float(1.0, "TP1 Risk:Reward",        minval=0.1, maxval=10,  step=0.1, group="TP Levels")
i_rr2         = input.float(1.5, "TP2 Risk:Reward",        minval=0.1, maxval=10,  step=0.1, group="TP Levels")
i_rr3         = input.float(2.0, "TP3 Risk:Reward",        minval=0.1, maxval=10,  step=0.1, group="TP Levels")
i_rr4         = input.float(3.0, "TP4 Risk:Reward",        minval=0.1, maxval=10,  step=0.1, group="TP Levels")
i_rr5         = input.float(4.0, "TP5 Risk:Reward",        minval=0.1, maxval=10,  step=0.1, group="TP Levels")
i_showTP4     = input.bool(true,  "Show TP4",              group="TP Levels")
i_showTP5     = input.bool(true,  "Show TP5",              group="TP Levels")

// Trade Management
i_trailSL     = input.bool(false, "Trailing Stop Loss",    group="Trade Management")
i_trailATR    = input.float(1.0,  "Trail ATR Multiplier",  minval=0.3, maxval=3.0, step=0.1, group="Trade Management")
i_breakEven   = input.bool(false, "Break-Even at TP1",     group="Trade Management")

// Confluence
i_useEMA      = input.bool(true, "EMA Trend Filter",       group="Confluence")
i_emaLen      = input.int(50,    "EMA Length",              minval=5,  maxval=200,  group="Confluence")
i_useRSI      = input.bool(true, "RSI Filter",             group="Confluence")
i_rsiLen      = input.int(14,    "RSI Length",              minval=3,  maxval=50,   group="Confluence")
i_rsiOB       = input.float(70,  "RSI Overbought",         minval=50, maxval=95,   group="Confluence")
i_rsiOS       = input.float(30,  "RSI Oversold",           minval=5,  maxval=50,   group="Confluence")
i_useVol      = input.bool(true, "Volume Spike Filter",    group="Confluence")
i_volMult     = input.float(1.5, "Volume Multiplier",      minval=1.0,maxval=5.0, step=0.1, group="Confluence")
i_useHTF      = input.bool(false,"Higher TF EMA Filter",   group="Confluence")
i_htfTF       = input.timeframe("60", "Higher TF",         group="Confluence")
i_htfEmaLen   = input.int(20,    "Higher TF EMA Length",   minval=5,  maxval=200,  group="Confluence")

// Design
i_buyCol      = input.color(#00E676, "Buy Color",          group="Design")
i_sellCol     = input.color(#FF1744, "Sell Color",          group="Design")
i_slCol       = input.color(#FF5252, "Stop Loss Color",     group="Design")
i_tpCol       = input.color(#69F0AE, "Take Profit Color",   group="Design")
i_entCol      = input.color(#FFFFFF, "Entry Line Color",     group="Design")
i_checkCol    = input.color(#00E676, "TP Hit Color",        group="Design")
i_txtCol      = input.color(#FFFFFF, "Text Color",          group="Design")
i_maxSetups   = input.int(5,     "Max Setups on Chart",     minval=1,  maxval=15,  group="Design")
i_showBox     = input.bool(true, "Show Setup Box",          group="Design")
i_showLabels  = input.bool(true, "Show Price Labels",       group="Design")
i_lineWidth   = input.int(1,     "Line Width",              minval=1,  maxval=4,   group="Design")

// Zones
i_showPD      = input.bool(true, "Premium/Discount BG",    group="Zones")
i_pdLen       = input.int(50,    "Range Lookback",          minval=10, maxval=200, group="Zones")

// ─────────────────────────────────────────────────────
// ██  SCALPING MODE OVERRIDES
// ─────────────────────────────────────────────────────

swingLen  = i_scalpMode ? 2       : i_swingLen
atrLen    = i_scalpMode ? 6       : i_atrLen
atrMult   = i_scalpMode ? 1.0     : i_atrMult
cooldown  = i_scalpMode ? 3       : i_cooldown
minAtrPct = i_scalpMode ? 0.3     : i_minAtrPct
useTP0    = i_scalpMode ? true    : i_useTP0
rr0       = i_scalpMode ? 0.4     : i_rr0
rr1       = i_scalpMode ? 0.75    : i_rr1
rr2       = i_scalpMode ? 1.25    : i_rr2
rr3       = i_scalpMode ? 2.0     : i_rr3
showTP4   = i_scalpMode ? false   : i_showTP4
showTP5   = i_scalpMode ? false   : i_showTP5
emaLen    = i_scalpMode ? 20      : i_emaLen
rsiLen    = i_scalpMode ? 6       : i_rsiLen
rsiOB     = i_scalpMode ? 65.0    : i_rsiOB
rsiOS     = i_scalpMode ? 35.0    : i_rsiOS
volMult   = i_scalpMode ? 1.2     : i_volMult
trailSL   = i_scalpMode ? true    : i_trailSL
breakEven = i_scalpMode ? true    : i_breakEven
showBox   = i_scalpMode ? false   : i_showBox
showLbls  = i_scalpMode ? false   : i_showLabels
lineW     = i_scalpMode ? 1       : i_lineWidth

// Non-overridden
rr4       = i_rr4
rr5       = i_rr5
trailATR  = i_trailATR

// ─────────────────────────────────────────────────────
// ██  GLOBAL CALCULATIONS (must run every bar)
// ─────────────────────────────────────────────────────

atrVal   = ta.atr(atrLen)
emaVal   = ta.ema(close, emaLen)
rsiVal   = ta.rsi(close, rsiLen)
avgVol   = ta.sma(volume, 20)
rangeH   = ta.highest(high, i_pdLen)
rangeL   = ta.lowest(low,   i_pdLen)
rangeMid = (rangeH + rangeL) / 2.0
rangeQ   = (rangeH - rangeL) * 0.25

// Higher TF EMA (runs every bar regardless of toggle)
htfEma   = request.security(syminfo.tickerid, i_htfTF, ta.ema(close, i_htfEmaLen), lookahead=barmerge.lookahead_off)

// Swing detection
pivHi = ta.pivothigh(high, swingLen, swingLen)
pivLo = ta.pivotlow(low,   swingLen, swingLen)

var float lastSH = na
var float lastSL_ = na
var int   trend  = 0

if not na(pivHi)
    lastSH := pivHi
if not na(pivLo)
    lastSL_ := pivLo

// Structure breaks
bosUp   = not na(lastSH)  and ta.crossover(close, lastSH)
bosDown = not na(lastSL_) and ta.crossunder(close, lastSL_)

if bosUp
    trend := 1
if bosDown
    trend := -1

// Min ATR filter (avoid flat markets)
atrPct = atrVal / close * 100.0
atrOk  = atrPct >= minAtrPct

// Confluence
emaOkUp   = i_useEMA == false or close > emaVal
emaOkDn   = i_useEMA == false or close < emaVal
rsiOkUp   = i_useRSI == false or rsiVal < rsiOB
rsiOkDn   = i_useRSI == false or rsiVal > rsiOS
volOk     = i_useVol  == false or volume > avgVol * volMult
htfOkUp   = i_useHTF  == false or close > htfEma
htfOkDn   = i_useHTF  == false or close < htfEma

// Signals with cooldown
var int lastSigBar = 0
coolOk = bar_index - lastSigBar > cooldown

buyGo  = bosUp   and emaOkUp and rsiOkUp and volOk and htfOkUp and atrOk and coolOk
sellGo = bosDown and emaOkDn and rsiOkDn and volOk and htfOkDn and atrOk and coolOk

if buyGo or sellGo
    lastSigBar := bar_index

// ─────────────────────────────────────────────────────
// ██  TRADE SETUP STORAGE (parallel arrays)
// ─────────────────────────────────────────────────────

var array<int>   s_bar     = array.new_int()
var array<int>   s_dir     = array.new_int()
var array<float> s_entry   = array.new_float()
var array<float> s_sl      = array.new_float()
var array<float> s_tp0     = array.new_float()
var array<float> s_tp1     = array.new_float()
var array<float> s_tp2     = array.new_float()
var array<float> s_tp3     = array.new_float()
var array<float> s_tp4     = array.new_float()
var array<float> s_tp5     = array.new_float()
var array<bool>  s_tp0Hit  = array.new_bool()
var array<bool>  s_tp1Hit  = array.new_bool()
var array<bool>  s_tp2Hit  = array.new_bool()
var array<bool>  s_tp3Hit  = array.new_bool()
var array<bool>  s_tp4Hit  = array.new_bool()
var array<bool>  s_tp5Hit  = array.new_bool()
var array<bool>  s_slHit   = array.new_bool()
var array<bool>  s_closed  = array.new_bool()
var array<bool>  s_beSet   = array.new_bool()   // break-even activated

// Drawing arrays
var array<box>   d_box     = array.new_box()
var array<line>  d_entry   = array.new_line()
var array<line>  d_sl      = array.new_line()
var array<line>  d_tp0     = array.new_line()
var array<line>  d_tp1     = array.new_line()
var array<line>  d_tp2     = array.new_line()
var array<line>  d_tp3     = array.new_line()
var array<line>  d_tp4     = array.new_line()
var array<line>  d_tp5     = array.new_line()
var array<label> d_entLbl  = array.new_label()
var array<label> d_slLbl   = array.new_label()
var array<label> d_tp0Lbl  = array.new_label()
var array<label> d_tp1Lbl  = array.new_label()
var array<label> d_tp2Lbl  = array.new_label()
var array<label> d_tp3Lbl  = array.new_label()
var array<label> d_tp4Lbl  = array.new_label()
var array<label> d_tp5Lbl  = array.new_label()
var array<label> d_sigLbl  = array.new_label()
var array<label> d_resLbl  = array.new_label()

// ─────────────────────────────────────────────────────
// ██  HELPER: delete oldest setup
// ─────────────────────────────────────────────────────

removeOldest() =>
    if array.size(s_bar) > 0
        array.shift(s_bar)
        array.shift(s_dir)
        array.shift(s_entry)
        array.shift(s_sl)
        array.shift(s_tp0)
        array.shift(s_tp1)
        array.shift(s_tp2)
        array.shift(s_tp3)
        array.shift(s_tp4)
        array.shift(s_tp5)
        array.shift(s_tp0Hit)
        array.shift(s_tp1Hit)
        array.shift(s_tp2Hit)
        array.shift(s_tp3Hit)
        array.shift(s_tp4Hit)
        array.shift(s_tp5Hit)
        array.shift(s_slHit)
        array.shift(s_closed)
        array.shift(s_beSet)
        box.delete(array.shift(d_box))
        line.delete(array.shift(d_entry))
        line.delete(array.shift(d_sl))
        line.delete(array.shift(d_tp0))
        line.delete(array.shift(d_tp1))
        line.delete(array.shift(d_tp2))
        line.delete(array.shift(d_tp3))
        line.delete(array.shift(d_tp4))
        line.delete(array.shift(d_tp5))
        label.delete(array.shift(d_entLbl))
        label.delete(array.shift(d_slLbl))
        label.delete(array.shift(d_tp0Lbl))
        label.delete(array.shift(d_tp1Lbl))
        label.delete(array.shift(d_tp2Lbl))
        label.delete(array.shift(d_tp3Lbl))
        label.delete(array.shift(d_tp4Lbl))
        label.delete(array.shift(d_tp5Lbl))
        label.delete(array.shift(d_sigLbl))
        label.delete(array.shift(d_resLbl))
    true

// ─────────────────────────────────────────────────────
// ██  CREATE NEW SETUP
// ─────────────────────────────────────────────────────

createNewSetup(int dir) =>
    float ep     = close
    float slDist = atrVal * atrMult
    float slP    = dir == 1 ? ep - slDist : ep + slDist
    float risk   = math.abs(ep - slP)
    float t0     = dir == 1 ? ep + risk * rr0 : ep - risk * rr0
    float t1     = dir == 1 ? ep + risk * rr1 : ep - risk * rr1
    float t2     = dir == 1 ? ep + risk * rr2 : ep - risk * rr2
    float t3     = dir == 1 ? ep + risk * rr3 : ep - risk * rr3
    float t4     = dir == 1 ? ep + risk * rr4 : ep - risk * rr4
    float t5     = dir == 1 ? ep + risk * rr5 : ep - risk * rr5
    int   rEdge  = bar_index + 30
    color mCol   = dir == 1 ? i_buyCol : i_sellCol

    // Store data
    array.push(s_bar, bar_index)
    array.push(s_dir, dir)
    array.push(s_entry, ep)
    array.push(s_sl, slP)
    array.push(s_tp0, t0)
    array.push(s_tp1, t1)
    array.push(s_tp2, t2)
    array.push(s_tp3, t3)
    array.push(s_tp4, t4)
    array.push(s_tp5, t5)
    array.push(s_tp0Hit, false)
    array.push(s_tp1Hit, false)
    array.push(s_tp2Hit, false)
    array.push(s_tp3Hit, false)
    array.push(s_tp4Hit, false)
    array.push(s_tp5Hit, false)
    array.push(s_slHit, false)
    array.push(s_closed, false)
    array.push(s_beSet, false)

    // Draw setup box (entry to TP1)
    float bxTop = dir == 1 ? t1 : ep
    float bxBot = dir == 1 ? ep : t1
    array.push(d_box, showBox ? box.new(bar_index, bxTop, rEdge, bxBot, border_color=mCol, bgcolor=color.new(mCol, 88), border_width=1) : box.new(bar_index, ep, rEdge, ep, border_color=na, bgcolor=na))

    // Draw lines
    array.push(d_entry, line.new(bar_index, ep,  rEdge, ep,  color=i_entCol, style=line.style_solid,  width=lineW + 1))
    array.push(d_sl,    line.new(bar_index, slP, rEdge, slP, color=i_slCol,  style=line.style_dashed, width=lineW + 1))
    array.push(d_tp0,   useTP0 ? line.new(bar_index, t0,  rEdge, t0,  color=color.new(i_tpCol, 30), style=line.style_dotted, width=lineW) : line.new(bar_index, ep, rEdge, ep, color=na))
    array.push(d_tp1,   line.new(bar_index, t1,  rEdge, t1,  color=i_tpCol,  style=line.style_dotted, width=lineW))
    array.push(d_tp2,   line.new(bar_index, t2,  rEdge, t2,  color=i_tpCol,  style=line.style_dotted, width=lineW))
    array.push(d_tp3,   line.new(bar_index, t3,  rEdge, t3,  color=i_tpCol,  style=line.style_dotted, width=lineW))
    array.push(d_tp4,   showTP4 ? line.new(bar_index, t4, rEdge, t4, color=i_tpCol, style=line.style_dotted, width=lineW) : line.new(bar_index, ep, rEdge, ep, color=na))
    array.push(d_tp5,   showTP5 ? line.new(bar_index, t5, rEdge, t5, color=i_tpCol, style=line.style_dotted, width=lineW) : line.new(bar_index, ep, rEdge, ep, color=na))

    // Signal label
    string sigTxt = dir == 1 ? "BUY" : "SELL"
    float sigY    = dir == 1 ? low - atrVal * 0.5 : high + atrVal * 0.5
    array.push(d_sigLbl, label.new(bar_index, sigY, sigTxt, style=dir == 1 ? label.style_label_up : label.style_label_down, color=mCol, textcolor=i_txtCol, size=size.large))

    // Price labels (conditional)
    array.push(d_entLbl, showLbls ? label.new(rEdge, ep,  "ENTRY " + str.tostring(ep, format.mintick),  style=label.style_label_left, color=color.new(mCol, 30),    textcolor=i_txtCol, size=size.small) : label.new(bar_index, ep, ""))
    array.push(d_slLbl,  showLbls ? label.new(rEdge, slP, "SL "    + str.tostring(slP, format.mintick), style=label.style_label_left, color=color.new(i_slCol, 30), textcolor=i_txtCol, size=size.small) : label.new(bar_index, ep, ""))
    array.push(d_tp0Lbl, showLbls and useTP0 ? label.new(rEdge, t0, "TP0 " + str.tostring(t0, format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny) : label.new(bar_index, ep, ""))
    array.push(d_tp1Lbl, showLbls ? label.new(rEdge, t1, "TP1 " + str.tostring(t1, format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny) : label.new(bar_index, ep, ""))
    array.push(d_tp2Lbl, showLbls ? label.new(rEdge, t2, "TP2 " + str.tostring(t2, format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny) : label.new(bar_index, ep, ""))
    array.push(d_tp3Lbl, showLbls ? label.new(rEdge, t3, "TP3 " + str.tostring(t3, format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny) : label.new(bar_index, ep, ""))
    array.push(d_tp4Lbl, showLbls and showTP4 ? label.new(rEdge, t4, "TP4 " + str.tostring(t4, format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny) : label.new(bar_index, ep, ""))
    array.push(d_tp5Lbl, showLbls and showTP5 ? label.new(rEdge, t5, "TP5 " + str.tostring(t5, format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny) : label.new(bar_index, ep, ""))

    // Result label placeholder
    array.push(d_resLbl, label.new(bar_index, ep, ""))
    true

// ─────────────────────────────────────────────────────
// ██  NEW SIGNALS
// ─────────────────────────────────────────────────────

if buyGo
    createNewSetup(1)

if sellGo
    createNewSetup(-1)

// Trim oldest if over limit
while array.size(s_bar) > i_maxSetups
    removeOldest()

// ─────────────────────────────────────────────────────
// ██  UPDATE ACTIVE SETUPS
// ─────────────────────────────────────────────────────

if array.size(s_bar) > 0
    for i = 0 to array.size(s_bar) - 1
        if array.get(s_closed, i)
            int _skip = 0
        else
            int   rE    = bar_index + 5
            int   d     = array.get(s_dir, i)
            bool  isBuy = d == 1
            float curSL = array.get(s_sl, i)
            float entP  = array.get(s_entry, i)

            // Extend drawings
            box.set_right(array.get(d_box, i), rE)
            line.set_x2(array.get(d_entry, i), rE)
            line.set_x2(array.get(d_sl, i),    rE)
            line.set_x2(array.get(d_tp0, i),   rE)
            line.set_x2(array.get(d_tp1, i),   rE)
            line.set_x2(array.get(d_tp2, i),   rE)
            line.set_x2(array.get(d_tp3, i),   rE)
            line.set_x2(array.get(d_tp4, i),   rE)
            line.set_x2(array.get(d_tp5, i),   rE)
            if showLbls
                label.set_x(array.get(d_entLbl, i), rE)
                label.set_x(array.get(d_slLbl, i),  rE)
                label.set_x(array.get(d_tp0Lbl, i), rE)
                label.set_x(array.get(d_tp1Lbl, i), rE)
                label.set_x(array.get(d_tp2Lbl, i), rE)
                label.set_x(array.get(d_tp3Lbl, i), rE)
                label.set_x(array.get(d_tp4Lbl, i), rE)
                label.set_x(array.get(d_tp5Lbl, i), rE)

            // ── Trailing SL ──
            if trailSL and array.get(s_tp1Hit, i) and not array.get(s_slHit, i)
                float trailDist = atrVal * trailATR
                float newSL = isBuy ? high - trailDist : low + trailDist
                if isBuy and newSL > curSL
                    array.set(s_sl, i, newSL)
                    line.set_y1(array.get(d_sl, i), newSL)
                    line.set_y2(array.get(d_sl, i), newSL)
                    if showLbls
                        label.set_y(array.get(d_slLbl, i), newSL)
                        label.set_text(array.get(d_slLbl, i), "TSL " + str.tostring(newSL, format.mintick))
                if not isBuy and newSL < curSL
                    array.set(s_sl, i, newSL)
                    line.set_y1(array.get(d_sl, i), newSL)
                    line.set_y2(array.get(d_sl, i), newSL)
                    if showLbls
                        label.set_y(array.get(d_slLbl, i), newSL)
                        label.set_text(array.get(d_slLbl, i), "TSL " + str.tostring(newSL, format.mintick))

            // ── TP0 ──
            if useTP0 and not array.get(s_tp0Hit, i)
                if (isBuy and high >= array.get(s_tp0, i)) or (not isBuy and low <= array.get(s_tp0, i))
                    array.set(s_tp0Hit, i, true)
                    label.set_text(array.get(d_tp0Lbl, i), "V TP0 " + str.tostring(array.get(s_tp0, i), format.mintick))
                    label.set_color(array.get(d_tp0Lbl, i), color.new(i_checkCol, 20))

            // ── TP1 + Break-Even ──
            if not array.get(s_tp1Hit, i)
                if (isBuy and high >= array.get(s_tp1, i)) or (not isBuy and low <= array.get(s_tp1, i))
                    array.set(s_tp1Hit, i, true)
                    label.set_text(array.get(d_tp1Lbl, i), "V TP1 " + str.tostring(array.get(s_tp1, i), format.mintick))
                    label.set_color(array.get(d_tp1Lbl, i), color.new(i_checkCol, 20))
                    // Break-Even: move SL to entry
                    if breakEven and not array.get(s_beSet, i)
                        array.set(s_beSet, i, true)
                        array.set(s_sl, i, entP)
                        line.set_y1(array.get(d_sl, i), entP)
                        line.set_y2(array.get(d_sl, i), entP)
                        line.set_color(array.get(d_sl, i), color.new(i_entCol, 40))
                        if showLbls
                            label.set_y(array.get(d_slLbl, i), entP)
                            label.set_text(array.get(d_slLbl, i), "BE " + str.tostring(entP, format.mintick))

            // ── TP2 ──
            if not array.get(s_tp2Hit, i)
                if (isBuy and high >= array.get(s_tp2, i)) or (not isBuy and low <= array.get(s_tp2, i))
                    array.set(s_tp2Hit, i, true)
                    label.set_text(array.get(d_tp2Lbl, i), "V TP2 " + str.tostring(array.get(s_tp2, i), format.mintick))
                    label.set_color(array.get(d_tp2Lbl, i), color.new(i_checkCol, 20))

            // ── TP3 ──
            if not array.get(s_tp3Hit, i)
                if (isBuy and high >= array.get(s_tp3, i)) or (not isBuy and low <= array.get(s_tp3, i))
                    array.set(s_tp3Hit, i, true)
                    label.set_text(array.get(d_tp3Lbl, i), "V TP3 " + str.tostring(array.get(s_tp3, i), format.mintick))
                    label.set_color(array.get(d_tp3Lbl, i), color.new(i_checkCol, 20))

            // ── TP4 ──
            if showTP4 and not array.get(s_tp4Hit, i)
                if (isBuy and high >= array.get(s_tp4, i)) or (not isBuy and low <= array.get(s_tp4, i))
                    array.set(s_tp4Hit, i, true)
                    label.set_text(array.get(d_tp4Lbl, i), "V TP4 " + str.tostring(array.get(s_tp4, i), format.mintick))
                    label.set_color(array.get(d_tp4Lbl, i), color.new(i_checkCol, 20))

            // ── TP5 (last = full TP) ──
            if showTP5 and not array.get(s_tp5Hit, i)
                if (isBuy and high >= array.get(s_tp5, i)) or (not isBuy and low <= array.get(s_tp5, i))
                    array.set(s_tp5Hit, i, true)
                    label.set_text(array.get(d_tp5Lbl, i), "V TP5 " + str.tostring(array.get(s_tp5, i), format.mintick))
                    label.set_color(array.get(d_tp5Lbl, i), color.new(i_checkCol, 20))
                    array.set(s_closed, i, true)
                    box.set_border_color(array.get(d_box, i), i_checkCol)
                    box.set_bgcolor(array.get(d_box, i), color.new(i_checkCol, 90))
                    float rY = isBuy ? high + atrVal * 0.3 : low - atrVal * 0.3
                    label.delete(array.get(d_resLbl, i))
                    array.set(d_resLbl, i, label.new(bar_index, rY, "FULL TP", style=isBuy ? label.style_label_down : label.style_label_up, color=i_checkCol, textcolor=color.black, size=size.normal))

            // If TP4/5 hidden, close on TP3
            if not showTP5 and not showTP4 and array.get(s_tp3Hit, i) and not array.get(s_closed, i)
                array.set(s_closed, i, true)
                box.set_border_color(array.get(d_box, i), i_checkCol)
                box.set_bgcolor(array.get(d_box, i), color.new(i_checkCol, 90))
                float rY3 = isBuy ? high + atrVal * 0.3 : low - atrVal * 0.3
                label.delete(array.get(d_resLbl, i))
                array.set(d_resLbl, i, label.new(bar_index, rY3, "FULL TP", style=isBuy ? label.style_label_down : label.style_label_up, color=i_checkCol, textcolor=color.black, size=size.normal))

            // If only TP4 hidden, close on TP4 level actually means TP3 is last visible but TP4 still tracked
            if not showTP5 and showTP4 and array.get(s_tp4Hit, i) and not array.get(s_closed, i)
                array.set(s_closed, i, true)
                box.set_border_color(array.get(d_box, i), i_checkCol)
                box.set_bgcolor(array.get(d_box, i), color.new(i_checkCol, 90))
                float rY4 = isBuy ? high + atrVal * 0.3 : low - atrVal * 0.3
                label.delete(array.get(d_resLbl, i))
                array.set(d_resLbl, i, label.new(bar_index, rY4, "FULL TP", style=isBuy ? label.style_label_down : label.style_label_up, color=i_checkCol, textcolor=color.black, size=size.normal))

            // ── SL hit ──
            if not array.get(s_slHit, i) and not array.get(s_closed, i)
                float checkSL = array.get(s_sl, i)
                if (isBuy and low <= checkSL) or (not isBuy and high >= checkSL)
                    array.set(s_slHit, i, true)
                    array.set(s_closed, i, true)
                    label.set_text(array.get(d_slLbl, i), "X SL " + str.tostring(checkSL, format.mintick))
                    label.set_color(array.get(d_slLbl, i), color.new(i_slCol, 10))
                    box.set_border_color(array.get(d_box, i), i_slCol)
                    box.set_bgcolor(array.get(d_box, i), color.new(i_slCol, 92))
                    line.set_color(array.get(d_entry, i), color.new(i_entCol, 70))
                    float rY2 = isBuy ? low - atrVal * 0.3 : high + atrVal * 0.3
                    label.delete(array.get(d_resLbl, i))
                    array.set(d_resLbl, i, label.new(bar_index, rY2, "STOPPED", style=isBuy ? label.style_label_up : label.style_label_down, color=i_slCol, textcolor=i_txtCol, size=size.normal))

            // Expire stale
            if bar_index - array.get(s_bar, i) > 200 and not array.get(s_closed, i)
                array.set(s_closed, i, true)

// ─────────────────────────────────────────────────────
// ██  PREMIUM / DISCOUNT BACKGROUND
// ─────────────────────────────────────────────────────

bool inPrem = close > rangeMid + rangeQ
bool inDisc = close < rangeMid - rangeQ

bgcolor(i_showPD and inPrem ? color.new(i_sellCol, 95) : na, title="Premium BG")
bgcolor(i_showPD and inDisc ? color.new(i_buyCol,  95) : na, title="Discount BG")

// ─────────────────────────────────────────────────────
// ██  EMA LINES
// ─────────────────────────────────────────────────────

plot(i_useEMA ? emaVal : na, "EMA", color=color.new(color.gray, 60), linewidth=1)
plot(i_useHTF ? htfEma : na, "HTF EMA", color=color.new(color.orange, 50), linewidth=2)

// ─────────────────────────────────────────────────────
// ██  INFO DASHBOARD
// ─────────────────────────────────────────────────────

var table dash = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 70))

if barstate.islast
    string tTxt = trend == 1 ? "BULLISH" : trend == -1 ? "BEARISH" : "NEUTRAL"
    color  tCol = trend == 1 ? i_buyCol  : trend == -1 ? i_sellCol : color.gray
    string zTxt = inPrem ? "PREMIUM" : inDisc ? "DISCOUNT" : "EQUILIBRIUM"
    color  zCol = inPrem ? i_sellCol : inDisc ? i_buyCol   : color.gray
    string mTxt = i_scalpMode ? "SCALPING" : "STANDARD"
    color  mCol2 = i_scalpMode ? color.yellow : color.silver

    int activeN = 0
    for j = 0 to math.max(array.size(s_bar) - 1, 0)
        if j < array.size(s_bar)
            if not array.get(s_closed, j)
                activeN += 1

    table.cell(dash, 0, 0, "MODE",    text_color=color.gray,   text_size=size.tiny)
    table.cell(dash, 1, 0, mTxt,      text_color=mCol2,        text_size=size.small)
    table.cell(dash, 0, 1, "TREND",   text_color=color.gray,   text_size=size.tiny)
    table.cell(dash, 1, 1, tTxt,      text_color=tCol,          text_size=size.small)
    table.cell(dash, 0, 2, "ZONE",    text_color=color.gray,   text_size=size.tiny)
    table.cell(dash, 1, 2, zTxt,      text_color=zCol,          text_size=size.small)
    table.cell(dash, 0, 3, "RSI",     text_color=color.gray,   text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(rsiVal, "#.0"), text_color=rsiVal > rsiOB ? i_sellCol : rsiVal < rsiOS ? i_buyCol : color.silver, text_size=size.small)
    table.cell(dash, 0, 4, "ACTIVE",  text_color=color.gray,   text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(activeN), text_color=color.silver, text_size=size.small)

// ─────────────────────────────────────────────────────
// ██  ALERTS
// ─────────────────────────────────────────────────────

alertcondition(buyGo,  title="BUY Signal",  message="BUY Signal — Institutional Liquidity Premium")
alertcondition(sellGo, title="SELL Signal",  message="SELL Signal — Institutional Liquidity Premium")
