// https://mozilla.org/MPL/2.0/
// © wyg3irushs — Institutional Liquidity Premium Indicator v2

//@version=5
indicator("Institutional Liquidity Premium v2", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────
// ██  INPUTS
// ─────────────────────────────────────────────────────

// Signal Engine
i_swingLen    = input.int(5,     "Swing Lookback",          minval=2,   maxval=50,  group="Signal Engine")
i_atrLen      = input.int(14,    "ATR Length",              minval=5,   maxval=50,  group="Signal Engine")
i_atrMult     = input.float(1.5, "ATR Multiplier (SL)",    minval=0.5, maxval=5.0, step=0.1, group="Signal Engine")
i_rr1         = input.float(1.0, "TP1 Risk:Reward",        minval=0.5, maxval=10,  step=0.5, group="Signal Engine")
i_rr2         = input.float(1.5, "TP2 Risk:Reward",        minval=0.5, maxval=10,  step=0.5, group="Signal Engine")
i_rr3         = input.float(2.0, "TP3 Risk:Reward",        minval=0.5, maxval=10,  step=0.5, group="Signal Engine")
i_rr4         = input.float(3.0, "TP4 Risk:Reward",        minval=0.5, maxval=10,  step=0.5, group="Signal Engine")
i_rr5         = input.float(4.0, "TP5 Risk:Reward",        minval=0.5, maxval=10,  step=0.5, group="Signal Engine")

// Confluence
i_useEMA      = input.bool(true, "EMA Trend Filter",       group="Confluence")
i_emaLen      = input.int(50,    "EMA Length",              minval=10, maxval=200,  group="Confluence")
i_useRSI      = input.bool(true, "RSI Filter",             group="Confluence")
i_rsiLen      = input.int(14,    "RSI Length",              minval=5,  maxval=50,   group="Confluence")
i_rsiOB       = input.float(70,  "RSI Overbought",         minval=60, maxval=90,   group="Confluence")
i_rsiOS       = input.float(30,  "RSI Oversold",           minval=10, maxval=40,   group="Confluence")
i_useVol      = input.bool(true, "Volume Spike Filter",    group="Confluence")
i_volMult     = input.float(1.5, "Volume Multiplier",      minval=1.0,maxval=5.0, step=0.1, group="Confluence")

// Design
i_buyCol      = input.color(#00E676, "Buy Color",          group="Design")
i_sellCol     = input.color(#FF1744, "Sell Color",          group="Design")
i_slCol       = input.color(#FF5252, "Stop Loss Color",     group="Design")
i_tpCol       = input.color(#69F0AE, "Take Profit Color",   group="Design")
i_entCol      = input.color(#FFFFFF, "Entry Line Color",     group="Design")
i_checkCol    = input.color(#00E676, "TP Hit Color",        group="Design")
i_txtCol      = input.color(#FFFFFF, "Text Color",          group="Design")
i_maxSetups   = input.int(5,     "Max Setups on Chart",     minval=1,  maxval=15,  group="Design")

// Zones
i_showPD      = input.bool(true, "Premium/Discount BG",    group="Zones")
i_pdLen       = input.int(50,    "Range Lookback",          minval=10, maxval=200, group="Zones")

// ─────────────────────────────────────────────────────
// ██  GLOBAL CALCULATIONS (must run every bar)
// ─────────────────────────────────────────────────────

atrVal   = ta.atr(i_atrLen)
emaVal   = ta.ema(close, i_emaLen)
rsiVal   = ta.rsi(close, i_rsiLen)
avgVol   = ta.sma(volume, 20)
rangeH   = ta.highest(high, i_pdLen)
rangeL   = ta.lowest(low,   i_pdLen)
rangeMid = (rangeH + rangeL) / 2.0
rangeQ   = (rangeH - rangeL) * 0.25

// Swing detection
pivHi = ta.pivothigh(high, i_swingLen, i_swingLen)
pivLo = ta.pivotlow(low,   i_swingLen, i_swingLen)

var float lastSH = na
var float lastSL = na
var int   trend  = 0

if not na(pivHi)
    lastSH := pivHi
if not na(pivLo)
    lastSL := pivLo

// Structure breaks
bosUp   = not na(lastSH) and ta.crossover(close, lastSH)
bosDown = not na(lastSL) and ta.crossunder(close, lastSL)

if bosUp
    trend := 1
if bosDown
    trend := -1

// Confluence
emaOkUp   = i_useEMA == false or close > emaVal
emaOkDn   = i_useEMA == false or close < emaVal
rsiOkUp   = i_useRSI == false or rsiVal < i_rsiOB
rsiOkDn   = i_useRSI == false or rsiVal > i_rsiOS
volOk     = i_useVol  == false or volume > avgVol * i_volMult

// Signals with cooldown
var int lastSigBar = 0
coolOk = bar_index - lastSigBar > i_swingLen * 2

buyGo  = bosUp   and emaOkUp and rsiOkUp and volOk and coolOk
sellGo = bosDown and emaOkDn and rsiOkDn and volOk and coolOk

if buyGo or sellGo
    lastSigBar := bar_index

// ─────────────────────────────────────────────────────
// ██  TRADE SETUP STORAGE (parallel arrays)
// ─────────────────────────────────────────────────────

var array<int>   s_bar     = array.new_int()
var array<int>   s_dir     = array.new_int()       // 1=buy, -1=sell
var array<float> s_entry   = array.new_float()
var array<float> s_sl      = array.new_float()
var array<float> s_tp1     = array.new_float()
var array<float> s_tp2     = array.new_float()
var array<float> s_tp3     = array.new_float()
var array<float> s_tp4     = array.new_float()
var array<float> s_tp5     = array.new_float()
var array<bool>  s_tp1Hit  = array.new_bool()
var array<bool>  s_tp2Hit  = array.new_bool()
var array<bool>  s_tp3Hit  = array.new_bool()
var array<bool>  s_tp4Hit  = array.new_bool()
var array<bool>  s_tp5Hit  = array.new_bool()
var array<bool>  s_slHit   = array.new_bool()
var array<bool>  s_closed  = array.new_bool()

// Drawing arrays
var array<box>   d_box     = array.new_box()
var array<line>  d_entry   = array.new_line()
var array<line>  d_sl      = array.new_line()
var array<line>  d_tp1     = array.new_line()
var array<line>  d_tp2     = array.new_line()
var array<line>  d_tp3     = array.new_line()
var array<line>  d_tp4     = array.new_line()
var array<line>  d_tp5     = array.new_line()
var array<label> d_entLbl  = array.new_label()
var array<label> d_slLbl   = array.new_label()
var array<label> d_tp1Lbl  = array.new_label()
var array<label> d_tp2Lbl  = array.new_label()
var array<label> d_tp3Lbl  = array.new_label()
var array<label> d_tp4Lbl  = array.new_label()
var array<label> d_tp5Lbl  = array.new_label()
var array<label> d_sigLbl  = array.new_label()
var array<label> d_resLbl  = array.new_label()

// ─────────────────────────────────────────────────────
// ██  HELPER: delete oldest setup drawings
// ─────────────────────────────────────────────────────

removeOldest() =>
    if array.size(s_bar) > 0
        array.shift(s_bar)
        array.shift(s_dir)
        array.shift(s_entry)
        array.shift(s_sl)
        array.shift(s_tp1)
        array.shift(s_tp2)
        array.shift(s_tp3)
        array.shift(s_tp4)
        array.shift(s_tp5)
        array.shift(s_tp1Hit)
        array.shift(s_tp2Hit)
        array.shift(s_tp3Hit)
        array.shift(s_tp4Hit)
        array.shift(s_tp5Hit)
        array.shift(s_slHit)
        array.shift(s_closed)
        box.delete(array.shift(d_box))
        line.delete(array.shift(d_entry))
        line.delete(array.shift(d_sl))
        line.delete(array.shift(d_tp1))
        line.delete(array.shift(d_tp2))
        line.delete(array.shift(d_tp3))
        line.delete(array.shift(d_tp4))
        line.delete(array.shift(d_tp5))
        label.delete(array.shift(d_entLbl))
        label.delete(array.shift(d_slLbl))
        label.delete(array.shift(d_tp1Lbl))
        label.delete(array.shift(d_tp2Lbl))
        label.delete(array.shift(d_tp3Lbl))
        label.delete(array.shift(d_tp4Lbl))
        label.delete(array.shift(d_tp5Lbl))
        label.delete(array.shift(d_sigLbl))
        label.delete(array.shift(d_resLbl))
    true

// ─────────────────────────────────────────────────────
// ██  CREATE NEW SETUP
// ─────────────────────────────────────────────────────

createNewSetup(int dir) =>
    float ep     = close
    float slDist = atrVal * i_atrMult
    float slP    = dir == 1 ? ep - slDist : ep + slDist
    float risk   = math.abs(ep - slP)
    float t1     = dir == 1 ? ep + risk * i_rr1 : ep - risk * i_rr1
    float t2     = dir == 1 ? ep + risk * i_rr2 : ep - risk * i_rr2
    float t3     = dir == 1 ? ep + risk * i_rr3 : ep - risk * i_rr3
    float t4     = dir == 1 ? ep + risk * i_rr4 : ep - risk * i_rr4
    float t5     = dir == 1 ? ep + risk * i_rr5 : ep - risk * i_rr5
    int   rEdge  = bar_index + 30
    color mCol   = dir == 1 ? i_buyCol : i_sellCol

    // Store data
    array.push(s_bar, bar_index)
    array.push(s_dir, dir)
    array.push(s_entry, ep)
    array.push(s_sl, slP)
    array.push(s_tp1, t1)
    array.push(s_tp2, t2)
    array.push(s_tp3, t3)
    array.push(s_tp4, t4)
    array.push(s_tp5, t5)
    array.push(s_tp1Hit, false)
    array.push(s_tp2Hit, false)
    array.push(s_tp3Hit, false)
    array.push(s_tp4Hit, false)
    array.push(s_tp5Hit, false)
    array.push(s_slHit, false)
    array.push(s_closed, false)

    // Draw setup box
    float bxTop = dir == 1 ? t1 : ep
    float bxBot = dir == 1 ? ep : t1
    array.push(d_box, box.new(bar_index, bxTop, rEdge, bxBot, border_color=mCol, bgcolor=color.new(mCol, 88), border_width=1))

    // Draw lines
    array.push(d_entry, line.new(bar_index, ep,  rEdge, ep,  color=i_entCol, style=line.style_solid,  width=2))
    array.push(d_sl,    line.new(bar_index, slP, rEdge, slP, color=i_slCol,  style=line.style_dashed, width=2))
    array.push(d_tp1,   line.new(bar_index, t1,  rEdge, t1,  color=i_tpCol,  style=line.style_dotted, width=1))
    array.push(d_tp2,   line.new(bar_index, t2,  rEdge, t2,  color=i_tpCol,  style=line.style_dotted, width=1))
    array.push(d_tp3,   line.new(bar_index, t3,  rEdge, t3,  color=i_tpCol,  style=line.style_dotted, width=1))
    array.push(d_tp4,   line.new(bar_index, t4,  rEdge, t4,  color=i_tpCol,  style=line.style_dotted, width=1))
    array.push(d_tp5,   line.new(bar_index, t5,  rEdge, t5,  color=i_tpCol,  style=line.style_dotted, width=1))

    // Signal label
    string sigTxt     = dir == 1 ? "BUY" : "SELL"
    float sigY = dir == 1 ? low - atrVal * 0.5 : high + atrVal * 0.5
    array.push(d_sigLbl, label.new(bar_index, sigY, sigTxt, style=dir == 1 ? label.style_label_up : label.style_label_down, color=mCol, textcolor=i_txtCol, size=size.large))

    // Price labels
    array.push(d_entLbl, label.new(rEdge, ep,  "ENTRY " + str.tostring(ep,  format.mintick), style=label.style_label_left, color=color.new(mCol, 30),    textcolor=i_txtCol, size=size.small))
    array.push(d_slLbl,  label.new(rEdge, slP, "SL "    + str.tostring(slP, format.mintick), style=label.style_label_left, color=color.new(i_slCol, 30), textcolor=i_txtCol, size=size.small))
    array.push(d_tp1Lbl, label.new(rEdge, t1,  "TP1 "   + str.tostring(t1,  format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny))
    array.push(d_tp2Lbl, label.new(rEdge, t2,  "TP2 "   + str.tostring(t2,  format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny))
    array.push(d_tp3Lbl, label.new(rEdge, t3,  "TP3 "   + str.tostring(t3,  format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny))
    array.push(d_tp4Lbl, label.new(rEdge, t4,  "TP4 "   + str.tostring(t4,  format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny))
    array.push(d_tp5Lbl, label.new(rEdge, t5,  "TP5 "   + str.tostring(t5,  format.mintick), style=label.style_label_left, color=color.new(i_tpCol, 50), textcolor=i_txtCol, size=size.tiny))

    // Result label placeholder (na for now)
    array.push(d_resLbl, label.new(bar_index, ep, ""))
    true

// ─────────────────────────────────────────────────────
// ██  NEW SIGNALS
// ─────────────────────────────────────────────────────

if buyGo
    createNewSetup(1)

if sellGo
    createNewSetup(-1)

// Trim oldest if over limit
while array.size(s_bar) > i_maxSetups
    removeOldest()

// ─────────────────────────────────────────────────────
// ██  UPDATE ACTIVE SETUPS
// ─────────────────────────────────────────────────────

if array.size(s_bar) > 0
    for i = 0 to array.size(s_bar) - 1
        if array.get(s_closed, i)
            // skip closed setups — just leave drawings as-is
            int _dummy = 0
        else
            int   rE    = bar_index + 5
            int   d     = array.get(s_dir, i)
            bool  isBuy = d == 1

            // Extend all drawings to current bar
            box.set_right(array.get(d_box, i), rE)
            line.set_x2(array.get(d_entry, i), rE)
            line.set_x2(array.get(d_sl, i),    rE)
            line.set_x2(array.get(d_tp1, i),   rE)
            line.set_x2(array.get(d_tp2, i),   rE)
            line.set_x2(array.get(d_tp3, i),   rE)
            line.set_x2(array.get(d_tp4, i),   rE)
            line.set_x2(array.get(d_tp5, i),   rE)
            label.set_x(array.get(d_entLbl, i), rE)
            label.set_x(array.get(d_slLbl, i),  rE)
            label.set_x(array.get(d_tp1Lbl, i), rE)
            label.set_x(array.get(d_tp2Lbl, i), rE)
            label.set_x(array.get(d_tp3Lbl, i), rE)
            label.set_x(array.get(d_tp4Lbl, i), rE)
            label.set_x(array.get(d_tp5Lbl, i), rE)

            // ── TP1 ──
            if not array.get(s_tp1Hit, i)
                if (isBuy and high >= array.get(s_tp1, i)) or (not isBuy and low <= array.get(s_tp1, i))
                    array.set(s_tp1Hit, i, true)
                    label.set_text(array.get(d_tp1Lbl, i), "V TP1 " + str.tostring(array.get(s_tp1, i), format.mintick))
                    label.set_color(array.get(d_tp1Lbl, i), color.new(i_checkCol, 20))

            // ── TP2 ──
            if not array.get(s_tp2Hit, i)
                if (isBuy and high >= array.get(s_tp2, i)) or (not isBuy and low <= array.get(s_tp2, i))
                    array.set(s_tp2Hit, i, true)
                    label.set_text(array.get(d_tp2Lbl, i), "V TP2 " + str.tostring(array.get(s_tp2, i), format.mintick))
                    label.set_color(array.get(d_tp2Lbl, i), color.new(i_checkCol, 20))

            // ── TP3 ──
            if not array.get(s_tp3Hit, i)
                if (isBuy and high >= array.get(s_tp3, i)) or (not isBuy and low <= array.get(s_tp3, i))
                    array.set(s_tp3Hit, i, true)
                    label.set_text(array.get(d_tp3Lbl, i), "V TP3 " + str.tostring(array.get(s_tp3, i), format.mintick))
                    label.set_color(array.get(d_tp3Lbl, i), color.new(i_checkCol, 20))

            // ── TP4 ──
            if not array.get(s_tp4Hit, i)
                if (isBuy and high >= array.get(s_tp4, i)) or (not isBuy and low <= array.get(s_tp4, i))
                    array.set(s_tp4Hit, i, true)
                    label.set_text(array.get(d_tp4Lbl, i), "V TP4 " + str.tostring(array.get(s_tp4, i), format.mintick))
                    label.set_color(array.get(d_tp4Lbl, i), color.new(i_checkCol, 20))

            // ── TP5 ──
            if not array.get(s_tp5Hit, i)
                if (isBuy and high >= array.get(s_tp5, i)) or (not isBuy and low <= array.get(s_tp5, i))
                    array.set(s_tp5Hit, i, true)
                    label.set_text(array.get(d_tp5Lbl, i), "V TP5 " + str.tostring(array.get(s_tp5, i), format.mintick))
                    label.set_color(array.get(d_tp5Lbl, i), color.new(i_checkCol, 20))
                    // All TPs hit
                    array.set(s_closed, i, true)
                    box.set_border_color(array.get(d_box, i), i_checkCol)
                    box.set_bgcolor(array.get(d_box, i), color.new(i_checkCol, 90))
                    float rY = isBuy ? high + atrVal * 0.3 : low - atrVal * 0.3
                    label.delete(array.get(d_resLbl, i))
                    array.set(d_resLbl, i, label.new(bar_index, rY, "FULL TP", style=isBuy ? label.style_label_down : label.style_label_up, color=i_checkCol, textcolor=color.black, size=size.normal))

            // ── SL ──
            if not array.get(s_slHit, i) and not array.get(s_closed, i)
                if (isBuy and low <= array.get(s_sl, i)) or (not isBuy and high >= array.get(s_sl, i))
                    array.set(s_slHit, i, true)
                    array.set(s_closed, i, true)
                    label.set_text(array.get(d_slLbl, i), "X SL " + str.tostring(array.get(s_sl, i), format.mintick))
                    label.set_color(array.get(d_slLbl, i), color.new(i_slCol, 10))
                    box.set_border_color(array.get(d_box, i), i_slCol)
                    box.set_bgcolor(array.get(d_box, i), color.new(i_slCol, 92))
                    line.set_color(array.get(d_entry, i), color.new(i_entCol, 70))
                    float rY2 = isBuy ? low - atrVal * 0.3 : high + atrVal * 0.3
                    label.delete(array.get(d_resLbl, i))
                    array.set(d_resLbl, i, label.new(bar_index, rY2, "STOPPED", style=isBuy ? label.style_label_up : label.style_label_down, color=i_slCol, textcolor=i_txtCol, size=size.normal))

            // Expire stale
            if bar_index - array.get(s_bar, i) > 200 and not array.get(s_closed, i)
                array.set(s_closed, i, true)

// ─────────────────────────────────────────────────────
// ██  PREMIUM / DISCOUNT BACKGROUND (global scope)
// ─────────────────────────────────────────────────────

bool inPrem = close > rangeMid + rangeQ
bool inDisc = close < rangeMid - rangeQ

bgcolor(i_showPD and inPrem ? color.new(i_sellCol, 95) : na, title="Premium BG")
bgcolor(i_showPD and inDisc ? color.new(i_buyCol,  95) : na, title="Discount BG")

// ─────────────────────────────────────────────────────
// ██  EMA LINE (global scope)
// ─────────────────────────────────────────────────────

plot(i_useEMA ? emaVal : na, "EMA", color=color.new(color.gray, 60), linewidth=1)

// ─────────────────────────────────────────────────────
// ██  INFO DASHBOARD
// ─────────────────────────────────────────────────────

var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 70))

if barstate.islast
    string tTxt = trend == 1 ? "BULLISH" : trend == -1 ? "BEARISH" : "NEUTRAL"
    color  tCol = trend == 1 ? i_buyCol  : trend == -1 ? i_sellCol : color.gray
    string zTxt = inPrem ? "PREMIUM" : inDisc ? "DISCOUNT" : "EQUILIBRIUM"
    color  zCol = inPrem ? i_sellCol : inDisc ? i_buyCol   : color.gray

    int activeN = 0
    for j = 0 to math.max(array.size(s_bar) - 1, 0)
        if j < array.size(s_bar)
            if not array.get(s_closed, j)
                activeN += 1

    table.cell(dash, 0, 0, "TREND",   text_color=color.gray,   text_size=size.tiny)
    table.cell(dash, 1, 0, tTxt,      text_color=tCol,          text_size=size.small)
    table.cell(dash, 0, 1, "ZONE",    text_color=color.gray,   text_size=size.tiny)
    table.cell(dash, 1, 1, zTxt,      text_color=zCol,          text_size=size.small)
    table.cell(dash, 0, 2, "RSI",     text_color=color.gray,   text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(rsiVal, "#.0"), text_color=rsiVal > i_rsiOB ? i_sellCol : rsiVal < i_rsiOS ? i_buyCol : color.silver, text_size=size.small)
    table.cell(dash, 0, 3, "ACTIVE",  text_color=color.gray,   text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(activeN), text_color=color.silver, text_size=size.small)

// ─────────────────────────────────────────────────────
// ██  ALERTS (global scope)
// ─────────────────────────────────────────────────────

alertcondition(buyGo,  title="BUY Signal",  message="BUY Signal — Institutional Liquidity Premium")
alertcondition(sellGo, title="SELL Signal",  message="SELL Signal — Institutional Liquidity Premium")
